        RowBox[{"3", "/", 
         RowBox[{"Tr", "[", "tauMat", "]"}]}], "]"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"tauMat", " ", "+", " ", 
       RowBox[{"beta", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
