            RowBox[{"Tr", "[", "tauMat", "]"}], "/", "3"}], ")"}], "^", 
          "delta"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"tauMat", "-", 
          RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ")"}]}]}], ")"}]}]}]}],
   ";"}], "\[IndentingNewLine]", 
