      RowBox[{"D", "[", 
       RowBox[{"tauMat", ",", "t"}], "]"}], "-", 
      RowBox[{"tauMat", ".", "dU"}], "-", 
      RowBox[{
       RowBox[{"Transpose", "[", "dU", "]"}], ".", "tauMat"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RoliePolyRHS", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"tauMat", "-", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ")"}]}], "-", 
