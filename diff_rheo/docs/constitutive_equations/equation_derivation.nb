Cell[BoxData[{
 RowBox[{
  RowBox[{"camelToSnake", "[", "camel_String", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s1", ",", "snake"}], "}"}], ",", 
    RowBox[{
     RowBox[{"s1", "=", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"camel", ",", 
        RowBox[{
         RowBox[{"RegularExpression", "[", "\"\<(.)([A-Z][a-z]+)\>\"", "]"}], 
         ":>", "\"\<$1_$2\>\""}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"snake", "=", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"s1", ",", 
        RowBox[{
         RowBox[{"RegularExpression", "[", "\"\<([a-z0-9])([A-Z])\>\"", "]"}],
          ":>", "\"\<$1_$2\>\""}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ToLowerCase", "[", "snake", "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"toPythonSyntax", "[", 
   RowBox[{"expr_", ",", 
    RowBox[{"name_", ":", "\"\<\>\""}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"intermediateExpr", ",", "intermediateExpr2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"intermediateExpr", " ", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"expr", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", "1", "]"}], "[", "func_", "]"}], "[", 
            "t", "]"}], ":>", 
           RowBox[{"Symbol", "[", 
            RowBox[{"\"\<d\>\"", "<>", 
             RowBox[{"ToString", "[", "func", "]"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"func_", "[", "t", "]"}], ":>", "func"}]}], "}"}]}], 
       "]"}]}], ";", " ", 
     RowBox[{"intermediateExpr2", "=", 
      RowBox[{"StringReplace", "[", 
       RowBox[{
        RowBox[{"ToString", "[", 
         RowBox[{"intermediateExpr", ",", "InputForm"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<Sqrt\>\"", "->", "\"\<jnp.sqrt\>\""}], ",", 
          RowBox[{"\"\<E^\>\"", "->", "\"\<jnp.exp\>\""}], ",", 
          RowBox[{"\"\<^\>\"", "->", "\"\<**\>\""}], ",", 
          RowBox[{"\"\<[\>\"", "->", "\"\<(\>\""}], ",", 
          RowBox[{"\"\<]\>\"", "->", "\"\<)\>\""}], ",", 
          RowBox[{"\"\<{\>\"", "->", "\"\<\>\""}], ",", 
          RowBox[{"\"\<}\>\"", "->", "\"\<\>\""}], ",", 
          RowBox[{"\"\<\\n\>\"", "->", "\"\<\>\""}], ",", 
          RowBox[{"\"\< \>\"", "->", "\"\<\>\""}], ",", 
          RowBox[{"\"\<->\>\"", "->", "\"\<=\>\""}], ",", 
          RowBox[{
           RowBox[{"RegularExpression", "[", "\"\<,\>\"", "]"}], 
           "->", "\"\<\\n\>\""}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"name", "!=", "\"\<\>\""}], ",", 
        RowBox[{"\"\<# \>\"", "<>", "name", "<>", "\"\<\\n\>\""}], 
        ",", "\"\<\>\""}], "]"}], "<>", 
      RowBox[{"camelToSnake", "[", "intermediateExpr2", "]"}]}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solveForViscoelasticEquations", "[", 
   RowBox[{"LHS_", ",", "RHS_", ",", 
    RowBox[{"name_", ":", "\"\<\>\""}], ",", 
    RowBox[{"toStringExpr_", ":", "True"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "extraStressEqn", ",", "totalStressEqn", ",", "extraStressSol", ",", 
      "totalStressSol"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"extraStressEqn", "=", 
      RowBox[{"LHS", "==", "RHS"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"extraStressSol", " ", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"Cancel", "[", " ", 
        RowBox[{"Solve", "[", 
         RowBox[{"extraStressEqn", ",", "extraStressSolveComponentList"}], 
         "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totalStressEqn", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"extraStressEqn", "/.", "extraStressRules"}], "/.", 
        "zeroNonShearStrainRuleList"}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totalStressSol", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"Cancel", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{"totalStressEqn", ",", "strainSolveComponentList"}], "]"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"toStringExpr", "==", "True"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"toPythonSyntax", "[", 
           RowBox[{"extraStressSol", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"name", "!=", "\"\<\>\""}], ",", 
              RowBox[{"name", "<>", "\"\< extra stress\>\""}], 
              ",", "\"\<\>\""}], "]"}]}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"toPythonSyntax", "[", 
           RowBox[{"totalStressSol", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"name", "!=", "\"\<\>\""}], ",", 
              RowBox[{"name", "<>", "\"\< strain solution\>\""}], 
              ",", "\"\<\>\""}], "]"}]}], "]"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"extraStressSol", ",", "totalStressSol"}], "}"}]}], "]"}]}]}],
    "\[IndentingNewLine]", "]"}]}]}], "Input",
 InitializationCell->True,
