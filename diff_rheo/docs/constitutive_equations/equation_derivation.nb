         RowBox[{"chiMax", "^", "2"}]}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"chi", "^", "2"}], "/", 
           RowBox[{"chiMax", "^", "2"}]}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"3", "-", 
          RowBox[{"1", "/", 
           RowBox[{"chiMax", "^", "2"}]}]}], ")"}]}], ")"}]}]}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RoliePolyLHS", " ", "=", " ", 
   RowBox[{"relaxationTime", "*", 
    RowBox[{"(", 
